# ============================================================
# PYTHON / DJANGO / ODOO - .gitignore
# ============================================================

# ------------------------------------------------------------
# Python - bytecode / cachés
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.pyright/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.dmypy.json
dmypy.json
.pyre/

# ------------------------------------------------------------
# Entornos virtuales
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Virtualenv
pip-wheel-metadata/

# ------------------------------------------------------------
# Variables de entorno / secretos
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

# Secret files
*.secret
*.secrets
secrets/
.secret/
credentials/
credentials.json

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------

# Local settings
local_settings.py
settings_local.py

# SQLite
*.sqlite
*.sqlite3
*.sqlite3-journal

# Django migrations:
# NO ignorar migrations normalmente.
# Las migraciones son parte del código y deben versionarse.
#
# Si tienes migraciones generadas automáticamente que NO quieres
# versionar, descomenta las siguientes líneas:
#
# **/migrations/*
# !**/migrations/__init__.py

# Django collected static files
staticfiles/
static_root/
media/
media_root/

# Django development files
*.log

# ------------------------------------------------------------
# Odoo
# ------------------------------------------------------------

# Odoo filestore
filestore/
*/filestore/

# Odoo sessions
sessions/
*/sessions/

# Odoo generated assets
*.assets.json

# Odoo logs
odoo.log
*.log

# Odoo local configuration
odoo.conf
*.conf

# Si necesitas versionar una configuración de ejemplo:
!odoo.conf.example
!*.conf.example

# Odoo attachments / generated files
attachments/
*/attachments/

# ------------------------------------------------------------
# Bases de datos
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# PostgreSQL dumps / backups
*.sql
*.dump
*.backup
*.bak

# Si necesitas versionar dumps concretos, usa excepciones:
# !database/schema.sql

# ------------------------------------------------------------
# Build / distribución Python
# ------------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
.eggs/

# Wheel metadata
*.whl

# ------------------------------------------------------------
# Jupyter
# ------------------------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------------------------
# Coverage
# ------------------------------------------------------------
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
*.log.*
log/

# ------------------------------------------------------------
# Temporales
# ------------------------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*.swn
*.bak
*.orig
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# IDEs / Editores
# ------------------------------------------------------------

# VS Code
.vscode/

# JetBrains / PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
.vim/
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# Emacs
*~
\#*\#
.\#*

# ------------------------------------------------------------
# OS
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Node / frontend
# Útil para Django/Odoo con frontend, webpack, npm, etc.
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

# Frontend build
.next/
.nuxt/
dist/
build/

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

# Datos persistentes locales
docker-data/
docker-data/*
volumes/
*.pid

# No ignoramos Dockerfiles ni docker-compose.yml
# porque normalmente forman parte del proyecto.

# ------------------------------------------------------------
# Test / herramientas
# ------------------------------------------------------------
.pytest_cache/
.hypothesis/
.nox/
.tox/

# ------------------------------------------------------------
# Celery
# ------------------------------------------------------------
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
dump.rdb
*.rdb

# ------------------------------------------------------------
# Mac / Windows / Linux
# ------------------------------------------------------------
.AppleDouble
.LSOverride
Icon
Icon?
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------
# Archivos locales de desarrollo
# ------------------------------------------------------------
*.local
*.local.*
local/
.local/

# ------------------------------------------------------------
# Backups
# ------------------------------------------------------------
*.backup
*.old
*.orig
*.save

# ------------------------------------------------------------
# Certificados / claves privadas
# ------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt

# IMPORTANTE:
# Si tu proyecto necesita certificados públicos versionados,
# crea excepciones específicas.
#
# !certs/public.crt

# ------------------------------------------------------------
# Archivos generados por herramientas
# ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.pyre/
.ipynb_checkpoints/

# ------------------------------------------------------------
# Archivos de sistema / lock temporales
# ------------------------------------------------------------
*.pid
*.pid.lock
*.seed
*.pidfile

# ------------------------------------------------------------
# Odoo / Python locales en subproyectos
# ------------------------------------------------------------

# Ignorar estos directorios EN CUALQUIER nivel del repositorio
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/env/
**/.coverage

# Filestore de Odoo en cualquier subproyecto
**/filestore/
**/sessions/

# ------------------------------------------------------------
# NO IGNORAR:
# ------------------------------------------------------------
# requirements.txt
# requirements-dev.txt
# pyproject.toml
# poetry.lock
# Pipfile
# Pipfile.lock
# setup.py
# setup.cfg
# manage.py
# __init__.py
# migrations/
# Dockerfile
# docker-compose.yml
# .env.example
# .gitkeep